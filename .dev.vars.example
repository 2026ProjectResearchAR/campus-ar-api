# Cloudflare Workers 実行時のローカルシークレット。
# このファイルをコピーして `.dev.vars` を作成し、実際の値を設定する（`.dev.vars` はコミットしない）。
# 本番は Cloudflare Dashboard もしくは `wrangler secret put <NAME>` で設定する。

# Supabase（PostgREST 経由の読み取りアクセス）
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# センサ計測値の書き込み（RLS バイパス）用。クライアントには公開しない。
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# IoTデバイスがセンサデータ送信時に提示する事前共有キー（Authorization: Bearer <key>）
SENSOR_INGEST_KEY="your-device-ingest-key"

# Cloudflare R2 の公開バケットのベースURL（末尾スラッシュ不要）
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Building {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  spots       Spot[]
  sensors     Sensor[]

  @@map("buildings")
}

model Spot {
  id          String      @id @default(uuid())
  buildingId  String      @map("building_id")
  name        String
  description String?
  markerId    String      @unique @map("marker_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  building    Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  arAssets    ArAsset[]
  userVisits  UserVisit[]

  @@map("spots")
}

model ArAsset {
  id          String   @id @default(uuid())
  spotId      String   @map("spot_id")
  type        String
  storagePath String   @map("storage_path")
  createdAt   DateTime @default(now()) @map("created_at")
  spot        Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("ar_assets")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("events")
}

model Sensor {
  id         String          @id @default(uuid())
  buildingId String?         @map("building_id")
  name       String
  type       String
  unit       String?
  createdAt  DateTime        @default(now()) @map("created_at")
  building   Building?       @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  readings   SensorReading[]

  @@index([buildingId])
  @@map("sensors")
}

model SensorReading {
  id         String   @id @default(uuid())
  sensorId   String   @map("sensor_id")
  value      Float
  recordedAt DateTime @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  sensor     Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, recordedAt])
  @@map("sensor_readings")
}

model UserVisit {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  spotId    String   @map("spot_id")
  visitedAt DateTime @default(now()) @map("visited_at")
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([spotId])
  @@map("user_visits")
}
